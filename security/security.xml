<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================ -->
        <!--              CATÉGORIE DU MODULE             -->
        <!-- ============================================ -->
        <record id="module_category_custom_account" model="ir.module.category">
            <field name="name">Custom Account API</field>
            <field name="sequence">100</field>
        </record>

        <!-- ============================================ -->
        <!--              GROUPES / RÔLES                 -->
        <!-- ============================================ -->

        <!-- Groupe : Producteur -->
        <record id="group_producteur" model="res.groups">
            <field name="name">Producteur</field>
            <field name="category_id" ref="module_category_custom_account"/>
            <field name="comment">
                Peut créer son compte, lire et modifier ses propres données.
                Ne peut pas supprimer de compte.
            </field>
        </record>

        <!-- Groupe : Waste-Picker -->
        <record id="group_waste_picker" model="res.groups">
            <field name="name">Waste-Picker</field>
            <field name="category_id" ref="module_category_custom_account"/>
            <field name="comment">
                Peut créer son compte, lire et modifier ses propres données.
                Peut lire les offres des producteurs. Ne peut pas supprimer de compte.
            </field>
        </record>

        <!-- Groupe : Administrateur -->
        <record id="group_admin" model="res.groups">
            <field name="name">Administrateur</field>
            <field name="category_id" ref="module_category_custom_account"/>
            <field name="implied_ids" eval="[(4, ref('group_producteur')), (4, ref('group_waste_picker'))]"/>
            <field name="comment">
                Accès total : créer, lire, modifier, supprimer tous les utilisateurs.
            </field>
        </record>

        <!-- ============================================ -->
        <!--              RECORD RULES                    -->
        <!-- ============================================ -->

        <!-- Producteur : ne voit/modifie que SES propres données -->
        <record id="rule_producteur_own_data" model="ir.rule">
            <field name="name">Producteur : accès à ses données uniquement</field>
            <field name="model_id" ref="model_custom_utilisateur"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_producteur'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Waste-Picker : accès à ses propres données + lecture des producteurs -->
        <record id="rule_waste_picker_own_data" model="ir.rule">
            <field name="name">Waste-Picker : accès à ses données uniquement</field>
            <field name="model_id" ref="model_custom_utilisateur"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('role', '=', 'producteur')]</field>
            <field name="groups" eval="[(4, ref('group_waste_picker'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Admin : aucune restriction (accès total) -->
        <record id="rule_admin_full_access" model="ir.rule">
            <field name="name">Admin : accès total</field>
            <field name="model_id" ref="model_custom_utilisateur"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
